r=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="310" width="360" height="44" as="geometry"/></mxCell><mxCell id="ab4" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="a4" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" value="номер заказа вручную" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="260" height="44" as="geometry"/></mxCell><mxCell id="b5" value="id выдаёт база (шаг 3 готовит к этому)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="370" width="360" height="44" as="geometry"/></mxCell><mxCell id="ab5" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="a5" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Дорожная карта" id="p5"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t5" value="Дорожная карта: все темы Java-бэкенда через CRM" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="h0" value="A. Core Java (консольная CRM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontSize=14;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="310" height="40" as="geometry"/></mxCell><mxCell id="k0" value="&lt;b&gt;✅ 1. Классы Client / Order&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;классы, конструктор, toString&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke1" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="h0" target="k0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;✅ 2. Список + поиск по телефону&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;List, for-each, equals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke2" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k0" target="k1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;3. Авто-номер заказа ← СЕЙЧАС&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;static, final + Git с этого шага&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke3" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;4. Сортировка заказов&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Comparable / Comparator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke4" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;5. Клиенты без дублей&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Map, Set, equals/hashCode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke5" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b&gt;6. Меню в консоли&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Scanner, исключения, свои Exception&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke6" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k4" target="k5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k6" value="&lt;b&gt;7. Статусы и деньги&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;enum, record, BigDecimal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="562" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke7" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k5" target="k6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k7" value="&lt;b&gt;8. Отчёты по продажам&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;lambda, Stream API, Optional&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="634" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke8" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k6" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k8" value="&lt;b&gt;9. Сохранение / импорт CSV&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;файлы, try-with-resources&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke9" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k7" target="k8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k9" value="&lt;b&gt;10. Параллельный импорт&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;потоки, ExecutorService, synchronized&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="778" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke10" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k8" target="k9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k10" value="&lt;b&gt;11. Сборка и тесты&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Maven, JUnit 5, Mockito&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke11" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k9" target="k10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1" value="B. Базы данных" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontSize=14;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="310" height="40" as="geometry"/></mxCell><mxCell id="k11" value="&lt;b&gt;12. SQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;PostgreSQL, JOIN, GROUP BY, индексы&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke12" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="h1" target="k11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k12" value="&lt;b&gt;13. Транзакции&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ACID, уровни изоляции&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="202" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke13" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k11" target="k12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k13" value="&lt;b&gt;14. JDBC&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;DAO для clients / orders&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="274" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke14" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k12" target="k13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2" value="C. Spring" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontSize=14;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="310" height="40" as="geometry"/></mxCell><mxCell id="k14" value="&lt;b&gt;15. Spring Boot + REST&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;IoC/DI, Controller-Service-Repository, HTTP-коды, DTO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke15" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="h2" target="k14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k15" value="&lt;b&gt;16. JPA / Hibernate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;связи @OneToMany, lazy, N+1, Flyway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="202" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke16" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k14" target="k15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k16" value="&lt;b&gt;17. Валидация и ошибки&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;@Valid, @ControllerAdvice, Swagger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="274" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke17" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k15" target="k16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k17" value="&lt;b&gt;18. Spring Security&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;JWT, роли ADMIN / MANAGER&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="346" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke18" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k16" target="k17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k18" value="&lt;b&gt;19. Тесты Spring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;@SpringBootTest, MockMvc, Testcontainers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="418" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke19" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k17" target="k18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h3" value="D. Прод и инфраструктура" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontSize=14;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="1060" y="70" width="310" height="40" as="geometry"/></mxCell><mxCell id="k19" value="&lt;b&gt;20. Docker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Dockerfile, docker-compose&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke20" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="h3" target="k19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k20" value="&lt;b&gt;21. Redis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;кэш @Cacheable, лимит логина&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="202" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke21" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k19" target="k20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k21" value="&lt;b&gt;22. Kafka / RabbitMQ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;событие заказа → notification-service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="274" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke22" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k20" target="k21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k22" value="&lt;b&gt;23. Интеграция с 1С&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;RestClient/WebClient, @Scheduled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="346" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke23" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k21" target="k22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k23" value="&lt;b&gt;24. Логи и мониторинг&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SLF4J, Actuator, Prometheus, Grafana&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="418" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke24" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k22" target="k23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k24" value="&lt;b&gt;25. CI/CD и деплой&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;GitHub Actions, Linux-сервер&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="490" width="310" height="56" as="geometry"/></mxCell><mxCell id="ke25" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="k23" target="k24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="th" value="&lt;b&gt;Теория к собесам — параллельно всему:&lt;/b&gt; ООП и SOLID · паттерны (Singleton, Factory, Strategy, Builder) · Big-O и устройство ArrayList/HashMap · JVM: память, heap/stack, GC · HTTP/REST · Git-flow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1330" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>