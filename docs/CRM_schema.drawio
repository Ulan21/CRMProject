ой" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="ci" target="dk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="Правило слоёв: Controller не ходит в БД напрямую — только Service → Repository.&lt;br&gt;Тесты: JUnit 5 + Mockito (Service), MockMvc (Controller), Testcontainers (БД)." style="shape=note;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="920" y="820" width="420" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Сущности (БД)" id="p3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="CRM — сущности и связи (таблицы БД)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;login (unique)&lt;br&gt;password_hash&lt;br&gt;role: ADMIN / MANAGER" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="230" height="118" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;clients&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;name&lt;br&gt;phone (unique)&lt;br&gt;city&lt;br&gt;address" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="230" height="140" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;products&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;name&lt;br&gt;sku (unique)&lt;br&gt;price (BigDecimal)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="230" height="118" as="geometry"/></mxCell><mxCell id="o" value="&lt;b&gt;orders&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;number (авто)&lt;br&gt;date (LocalDate)&lt;br&gt;status: NEW / IN_WORK / DONE / CANCELED&lt;br&gt;client_id (FK → clients)&lt;br&gt;manager_id (FK → users)&lt;br&gt;total (BigDecimal)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="370" width="230" height="184" as="geometry"/></mxCell><mxCell id="oi" value="&lt;b&gt;order_items&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;order_id (FK → orders)&lt;br&gt;product_id (FK → products)&lt;br&gt;quantity&lt;br&gt;price (BigDecimal)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="800" y="420" width="230" height="140" as="geometry"/></mxCell><mxCell id="r1" value="1 менеджер — N заказов" style="endArrow=ERmany;startArrow=ERone;html=1;endFill=0;startFill=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="u" target="o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="1 клиент — N заказов" style="endArrow=ERmany;startArrow=ERone;html=1;endFill=0;startFill=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="c" target="o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="1 заказ — N позиций" style="endArrow=ERmany;startArrow=ERone;html=1;endFill=0;startFill=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="o" target="oi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="1 товар — N позиций" style="endArrow=ERmany;startArrow=ERone;html=1;endFill=0;startFill=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="p" target="oi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n2" value="PK — первичный ключ (уникальный id строки)&lt;br&gt;FK — внешний ключ (ссылка на строку другой таблицы)&lt;br&gt;В Java: поле Client client в Order → в БД колонка client_id" style="shape=note;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="520" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Сейчас → потом" id="p4"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t3" value="Что уже есть → во что превратится" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="a0" value="Client, Order" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="44" as="geometry"/></mxCell><mxCell id="b0" value="@Entity → таблицы clients, orders" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="360" height="44" as="geometry"/></mxCell><mxCell id="ab0" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;" edge="1" parent="1" source="a0" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" value="OrderService" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="260" height="44" as="geometry"/></mxCell><mxCell id="b1" value="@Service (логика почти та же)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="13