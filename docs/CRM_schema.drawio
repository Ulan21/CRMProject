<mxfile host="app.diagrams.net"><diagram name="1. Архитектура" id="p2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="CRM — архитектура (финальная)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="fe" value="Браузер / фронт" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="180" height="56" as="geometry"/></mxCell><mxCell id="pm" value="Postman / Swagger UI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="80" width="180" height="56" as="geometry"/></mxCell><mxCell id="c1" value="1С (OData)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="180" height="56" as="geometry"/></mxCell><mxCell id="ci" value="GitHub Actions&lt;br&gt;CI/CD: тесты → сборка → деплой" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="300" height="56" as="geometry"/></mxCell><mxCell id="dk" value="🐳 docker-compose (сервер)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=none;strokeColor=#0b78d0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="1340" height="800" as="geometry"/></mxCell><mxCell id="app" value="crm-service (Spring Boot)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;fillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="820" height="590" as="geometry"/></mxCell><mxCell id="sec" value="🔒 Spring Security + JWT: логин, роли ADMIN / MANAGER" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="760" height="46" as="geometry"/></mxCell><mxCell id="ctl" value="&lt;b&gt;① Controller&lt;/b&gt; (REST, DTO, @Valid, @ControllerAdvice, OpenAPI)&lt;br&gt;ClientController · OrderController · ProductController · AuthController" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="760" height="70" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;② Service&lt;/b&gt; — бизнес-логика, @Transactional&lt;br&gt;ClientService · OrderService · ProductService · ImportService (@Scheduled, 1С)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="760" height="70" as="geometry"/></mxCell><mxCell id="rep" value="&lt;b&gt;③ Repository&lt;/b&gt; — Spring Data JPA / Hibernate&lt;br&gt;ClientRepository · OrderRepository · ProductRepository · UserRepository" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="550" width="760" height="70" as="geometry"/></mxCell><mxCell id="ent" value="&lt;b&gt;Entity&lt;/b&gt;: User · Client · Product · Order · OrderItem   |   миграции: Flyway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="70" y="660" width="760" height="46" as="geometry"/></mxCell><mxCell id="log" value="Логи SLF4J/Logback · Actuator /health /metrics" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="70" y="730" width="760" height="40" as="geometry"/></mxCell><mxCell id="db" value="PostgreSQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;f